# ==============================================================================
# Open Source Assist - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment:
#   cp .env.example .env
# ==============================================================================

# Application Environment (development | testing | production)
ENVIRONMENT=development

# API Route Prefix
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# Qdrant Vector Database Server Configuration (Server Only)
# ------------------------------------------------------------------------------
# Option 1: Local Qdrant Server (Docker or Native Binary)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Option 2: Qdrant Cloud (Managed production cluster)
# QDRANT_URL=https://<your-cluster-id>.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-secret-qdrant-cloud-api-key

# Use gRPC for high-throughput serialization (Optional: true | false)
QDRANT_PREFER_GRPC=false

# Collection identifier for open-source repositories
QDRANT_COLLECTION_NAME=open_source_repositories

# Dense vector dimensionality matching the embedding model (384 for bge-small)
QDRANT_VECTOR_SIZE=384

# ------------------------------------------------------------------------------
# Embedding Model Configuration
# ------------------------------------------------------------------------------
# Local ONNX model name handled via FastEmbed
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# ------------------------------------------------------------------------------
# Search & Popularity Ranking Hyperparameters
# ------------------------------------------------------------------------------
# Default weight alpha given to popularity [0.0 = pure semantic, 1.0 = heavy popularity boost]
DEFAULT_POPULARITY_WEIGHT=0.3

# Semantic candidate retrieval count from Qdrant prior to reranking
CANDIDATE_SEARCH_LIMIT=100

# Default pagination page size
DEFAULT_PAGE_LIMIT=20

# ------------------------------------------------------------------------------
# PostgreSQL Database (GitHub Pipeline & Events)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ------------------------------------------------------------------------------
# GitHub API
# ------------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_MIN_REQUEST_INTERVAL=1.0
GITHUB_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# JWT & OTP
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-long-random-secret-for-jwt-signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
OTP_EXPIRE_MINUTES=5

# ------------------------------------------------------------------------------
# SMTP Email (for OTP delivery)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_START_TLS=true

# ------------------------------------------------------------------------------
# Gemini LLM Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ------------------------------------------------------------------------------
# Airflow REST API
# ------------------------------------------------------------------------------
AIRFLOW_API_URL=http://localhost:8080
AIRFLOW_API_USERNAME=
AIRFLOW_API_PASSWORD=
AIRFLOW_DAG_ID=github_sync_weekly

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=true
CORS_ALLOW_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
